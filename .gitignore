# 本地备份与临时产物不入库（.mt-cache.json 翻译缓存要入库，跨天复用省配额）
.bak/
.tmp/
*.log

# 例句源数据缓存（44MB）；重新拉取命令见 tools/build-examples.mjs 顶部注释
tools/.examples-cache/
# 正文覆盖率对账（audit-coverage.mjs）的原文快照缓存。判定的是「库里 vs 当时的原文」，
# 缓存命中就不联网 —— 反复跑结果必须一致，所以缓存是正确性的一部分而不是提速手段。
# 体积大（每篇几十到几百 KB 的整页 HTML），不入库。
tools/.coverage-cache/
# 例外：两张小表是构建的必需输入，随仓库走
#   cet4-hf.json      17KB  真题高频表，build-core-vocab.mjs 用
#   cet4-sprint.json  36KB  冲刺池（真题表 ∪ CETVocabulary 词频），build-words-mid.mjs 用
#   cet4-gaps-general.json 1KB 通用高频向缺口词，build-core-vocab.mjs 用
!tools/.examples-cache/
tools/.examples-cache/*
!tools/.examples-cache/cet4-hf.json
!tools/.examples-cache/cet4-sprint.json
!tools/.examples-cache/cet4-gaps-general.json

# 本地密钥，绝不入库
tools/.deepl-key
tools/.ecdict-blob.json

# 抓取残留 / 会话产物 —— 不参与构建、不该进公开仓库。
# 它们此前只是「未跟踪」，一旦有人走 git-status 路线 push 就会被一起传上去。
# _aesop-raw.html 另在 _api-push.mjs 的 NEVER_PUSH 里兜底，这里再拦一道。
.tmp-*.html
tools/.remote-articles.js
tools/_aesop-raw.html
# 本地工作区/会话目录（agent 记忆、计划稿），仓库公开，不入库
.zcode/
.workbuddy/

# 人工抽查材料（spot-check.mjs 生成，逐句对照 + 记录模板），属一次性产物
tools/_spot/
